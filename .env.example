# ============================================================================
#  Online Judge – single configuration file (used by docker compose)
#  Copy this file to ".env"  (Copy-Item .env.example .env)  and fill in ONE value.
# ============================================================================

# >>> THE ONLY VALUE YOU MUST PROVIDE <<<
# Your MongoDB Atlas connection string.
# Atlas -> Connect -> Drivers -> copy the "mongodb+srv://..." string.
# Do NOT wrap it in quotes. If your password has special characters, URL-encode them.
MONGODB_URL=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/OJdatabase

# ----------------------------------------------------------------------------
# Everything below already has a working default – you can ignore it for local use.
# ----------------------------------------------------------------------------

# Secret used to sign login tokens. Fine as-is for local/testing.
# CHANGE THIS to a long random value before exposing the app publicly.
JWT_SECRET=dev-secret-change-me-in-production

# URL the browser uses to reach the backend.
# For local docker compose leave this as-is. In production set it to your public backend URL.
REACT_APP_API_URL=http://localhost:4000

# Optional: restrict which frontend origins may call the API (comma separated).
# Leave empty to allow all origins.
CORS_ORIGIN=
