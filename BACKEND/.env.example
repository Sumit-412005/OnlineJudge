# Copy this file to ".env" and fill in your own values. NEVER commit the real .env.

# Port the API server listens on
PORT=4000

# MongoDB connection string (e.g. a MongoDB Atlas SRV URI)
MONGODB_URL="mongodb+srv://<user>:<password>@<cluster>.mongodb.net/OJdatabase"

# Secret used to sign JWTs – use a long, random value
JWT_SECRET="change_me_to_a_long_random_secret"

# Optional: comma-separated list of allowed frontend origins for CORS.
# Leave unset to allow all origins (fine for local dev).
# CORS_ORIGIN=https://your-frontend.example.com
